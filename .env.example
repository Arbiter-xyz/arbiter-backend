# Server
PORT=3000

# Stellar network
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org

# Oracle
ORACLE_SECRET_KEY=
MAX_QUESTION_LENGTH=500
MAX_ANSWER_LENGTH=2000
MAX_CATEGORY_LENGTH=64
MAX_WORKER_ID_LENGTH=128

# Admin
ADMIN_TOKEN=

# Home domain of the SEP-24/SEP-12 anchor used for the app's fiat rails
# (bank deposit/withdraw, KYC status — see anchorClient.js). Unset disables
# /anchor/* entirely.
ANCHOR_HOME_DOMAIN=

# Non-crypto onramp (billing.js): API-key customers pay via Stripe and are
# settled on-chain from ONE pooled balance under FIAT_POOL_ADDRESS —
# deliberately a DIFFERENT keypair than PLATFORM_SECRET/PLATFORM_ADDRESS
# above, so customer float never commingles with platform fee revenue. All
# four must be set for /billing/* and the API-key path of POST /oracle to
# work; unset disables that surface entirely (fails closed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FIAT_POOL_SECRET=
FIAT_POOL_ADDRESS=
MIN_TOPUP_USD=10

# Settlement webhooks (webhooks.js / webhookDelivery.js). All optional.
# Key used to encrypt webhook signing secrets at rest (AES-256-GCM). Set it
# for production. Changing it later makes existing secrets unreadable, so
# owners would have to re-register.
WEBHOOK_SECRET_ENCRYPTION_KEY=
# Delivery attempts per event (including the first) and the first retry
# delay; each later retry doubles it (+ up to 20% jitter).
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_RETRY_BASE_DELAY_MS=5000
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_PER_OWNER=10
# LOCAL DEV ONLY: allow http:// and loopback/private-network webhook targets.
# Never enable in production (it turns registration into an SSRF vector).
WEBHOOK_ALLOW_INSECURE_TARGETS=false

# Auto-withdraw (autoWithdraw.js). The backend never signs for a worker:
# when a worker's Owed crosses their threshold it prepares the unsigned
# withdraw transaction and pushes it to them to sign. All optional.
AUTO_WITHDRAW_MIN_THRESHOLD_STROOPS=10000000
AUTO_WITHDRAW_SWEEP_INTERVAL_MS=900000
AUTO_WITHDRAW_PENDING_TTL_MS=86400000

# Annual earnings summaries for tax reporting (taxReport.js). The payer
# fields are the platform's own details for the PAYER box. All optional.
TAX_REPORTING_THRESHOLD_USD=600
TAX_PAYER_NAME=
TAX_PAYER_TIN=
TAX_PAYER_ADDRESS=
