# Comma-separated list of admin bearer tokens for the /admin/* console.
# Any token in this list authenticates independently, so a single operator's
# access can be revoked by removing just their token value (no full-team
# rotation). Note: this is still not per-operator identity — a request
# authenticated with any valid token is indistinguishable from any other.
ADMIN_TOKENS=

# Legacy single admin token. Still supported for backward compatibility and
# folded into the same token list as ADMIN_TOKENS.
ADMIN_TOKEN=
