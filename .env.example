# Server port
PORT=3000

# Comma-separated list of allowed CORS origins.
# Local dev default is permissive; set explicit origins in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Express "trust proxy" setting, used so req.ip reflects the real client
# address (via X-Forwarded-For) when running behind a reverse proxy.
#
# Leave unset for local dev: req.ip is the raw socket peer address.
#
# Behind Railway (or any single reverse proxy that terminates TLS and
# forwards to this process), set this to 1 to trust exactly one hop.
# Do NOT set it to "true"/"*" unless every hop in front of the app is
# trusted, otherwise clients can spoof X-Forwarded-For and defeat the
# per-IP rate limits and the SSE anti-sybil connection guard.
#
# Other topologies: use the number of trusted proxy hops, a subnet/CIDR
# list, or a named preset ("loopback", "linklocal", "uniquelocal").
# TRUST_PROXY=1
