# Every environment variable the backend reads (process.env.X anywhere under
# src/) has an entry here; scripts/check-env-example.js fails CI when one is
# missing or when an entry here is no longer read anywhere.
#
# Copy to .env and fill in the REQUIRED block. Everything else is optional
# and shows its default. Blank means "unset", which is the documented
# default for that variable.

# =============================================================================
# REQUIRED — without these the backend cannot do anything on-chain
# =============================================================================

# The deployed oracle-escrow contract instance (C...). Every question is
# submit()ed to, and every resolve()/refund() is signed against, this id.
ORACLE_CONTRACT_ID=

# The platform admin keypair (S... / G...). PLATFORM_SECRET signs every
# resolve()/refund()/charge()/touch() call and receives the platform fee cut
# at PLATFORM_ADDRESS, so the two must be the same keypair, and that keypair
# must be the admin the contract was initialize()'d with.
PLATFORM_SECRET=
PLATFORM_ADDRESS=

# The USDC Stellar Asset Contract id (C...) the contract escrows in.
USDC_SAC_ID=

# =============================================================================
# Stellar network
# =============================================================================

# Defaults are Stellar testnet. For mainnet, change all three together.
HORIZON_URL=https://horizon-testnet.stellar.org
# Comma-separated list for RPC failover (#139), primary first.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# USDC classic asset (the trustline workers and payers hold). The default
# issuer is Circle's testnet USDC.
USDC_ASSET_CODE=USDC
USDC_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Must match the timeout_ledgers the contract was initialize()'d with. This
# copy is for display only ("auto-refund available after ledger N"); the
# contract enforces its own stored value regardless.
TIMEOUT_LEDGERS=100

# Pinned arbiter-contract release (#163). At startup the deployed WASM hash
# is compared against COMPATIBLE_CONTRACT_WASM_HASH (from that release's
# notes) and a mismatch logs a loud warning. Blank skips the check.
COMPATIBLE_CONTRACT_VERSION=
COMPATIBLE_CONTRACT_WASM_HASH=

# Sharded multi-contract dispatch (#162). Comma-separated contract ids; when
# set, new questions are routed round-robin across them instead of going to
# ORACLE_CONTRACT_ID alone. Leave blank for the usual single contract.
CONTRACT_IDS=
# Recorded against each CONTRACT_IDS entry. NOTE: nothing signs with this
# today — every admin call signs with PLATFORM_SECRET above, so don't set
# this expecting it to replace PLATFORM_SECRET.
ADMIN_SECRET_KEY=

# =============================================================================
# Server and infrastructure
# =============================================================================

PORT=4000

# Serve the built frontend (app/dist) from this Express process via
# express.static. Defaults to true so `npm start`-style local/demo runs keep
# working out of the box. Set to false when a CDN/Vercel deployment fronts the
# app build, so static-asset traffic never enters this process's middleware
# chain (httpLogger/CORS) or competes with settlement API routes.
SERVE_STATIC_APP=true

# Optional. Unset = in-memory store: single instance only, and all state
# (pending questions, jobs, reputation, sessions) is lost on restart. Use
# rediss:// (TLS) for anything non-local; securityPosture.js flags redis://.
REDIS_URL=

# Optional read replica for the admin console's heavy read endpoints (#92,
# replicaStore.js). Only /admin/* list/summary reads use it; dispatch and
# settlement always read REDIS_URL. Needs REDIS_URL to be set too. Blank =
# admin reads use the primary. After a failed replica read, admin reads use
# the primary for REDIS_REPLICA_RETRY_AFTER_MS before trying it again.
REDIS_REPLICA_URL=
REDIS_REPLICA_RETRY_AFTER_MS=30000

# Comma-separated allowed CORS origins, e.g.
# "https://app.example.com,https://demo.example.com". Defaults to '*' (wide
# open) for local dev — lock this down for any real deployment.
ALLOWED_ORIGINS=*

# Express `trust proxy` hop count. Unset/0 = trust nothing (req.ip is the raw
# socket address — right for local dev). Behind Railway set 1. Never more
# hops than you actually have: extra trust lets clients spoof req.ip and
# dodge every per-IP rate limit.
TRUST_PROXY=

# 'json' for real deployments (log aggregators parse it); anything else
# pretty-prints for local dev.
LOG_FORMAT=pretty
LOG_LEVEL=info

# 'demo' (disposable) or 'sandbox' (long-lived developer sandbox), #150.
# Labeling only; anything else is treated as 'demo'.
DEPLOYMENT_PROFILE=demo

# Startup security-posture check (src/securityPosture.js). A deployment is
# treated as production if ANY of these is true: NODE_ENV=production,
# ARBITER_ENV=production, a mainnet NETWORK_PASSPHRASE, a non-local
# REDIS_URL, or a hosting-platform marker (RAILWAY_ENVIRONMENT, RENDER,
# FLY_APP_NAME, DYNO, K_SERVICE, AWS_EXECUTION_ENV, KUBERNETES_SERVICE_HOST).
# In production it refuses to start without SESSION_SECRET, and logs an
# error for ALLOWED_ORIGINS=* or a non-TLS (redis://) REDIS_URL. Set
# ARBITER_ENV=production on a self-hosted box that has none of the other
# signals. There is intentionally no way to switch the check off.
# NODE_ENV=
# ARBITER_ENV=

# =============================================================================
# Canary deployments (#89, canary.js, docs/runbooks/canary-deployment.md)
# =============================================================================

# 'primary' (default) or 'canary'. A canary serves only CANARY_READ_PATHS
# (GET), answers everything else with 503 so it goes to the primary, never
# signs as the platform key, and runs no background sweeps.
INSTANCE_ROLE=primary
CANARY_READ_PATHS=/health,/leaderboard,/leaderboard/xp,/stats,/maintenance,/gamification/badges

# Cross-instance lock around every platform-key transaction (shared via
# REDIS_URL), so two primaries never race the account's sequence number.
# TTL must outlast one admin call including retries; WAIT is how long a call
# waits for another instance's lock before failing.
SIGNER_LOCK_TTL_MS=60000
SIGNER_LOCK_WAIT_MS=90000

# On SIGTERM, how long to keep running so in-flight quorums can settle
# before exit. Set your platform's shutdown grace period at least this long.
DRAIN_TIMEOUT_MS=120000

# =============================================================================
# LLM (reconcile / instant tier / draft answers)
# =============================================================================

# 'anthropic' is the only provider today; anything else fails startup.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Fleet-wide Claude spend cap (#6), shared across instances via the store.
# Once spent within the rolling window, Claude-backed paths are refused
# until it rolls over. Default $10/hour.
CLAUDE_FLEET_BUDGET_CENTS=1000
CLAUDE_FLEET_WINDOW_MS=3600000

# =============================================================================
# Request input limits
# =============================================================================

MAX_QUESTION_LENGTH=2000
MAX_ANSWER_LENGTH=2000
MAX_CATEGORY_LENGTH=64
MAX_WORKER_ID_LENGTH=128

# Profanity/spam filter on worker answers (src/answerFilter.js). Rejected
# answers never enter the quorum collector, so they can't sway consensus.
# BLOCKLIST is comma-separated, matched case-insensitively on word
# boundaries. MAX_LINKS=-1 or 0 for the other limits disables that check.
ANSWER_FILTER_ENABLED=false
ANSWER_FILTER_BLOCKLIST=
ANSWER_FILTER_MAX_LINKS=2
ANSWER_FILTER_MAX_REPEATED_CHARS=10
ANSWER_FILTER_MAX_UPPERCASE_RATIO=0.8
ANSWER_FILTER_MIN_LETTERS_FOR_CASE_CHECK=20

# =============================================================================
# Rate limits (per IP, max requests per window)
# =============================================================================

# Every one of these endpoints either costs the platform a real network fee
# per call (/sponsor/*) or writes unbounded state (/oracle), so all get a
# per-IP rate limit, not just the SSE connection endpoint.
ORACLE_RATE_LIMIT_MAX=20
ORACLE_RATE_LIMIT_WINDOW_MS=60000
SPONSOR_RATE_LIMIT_MAX=10
SPONSOR_RATE_LIMIT_WINDOW_MS=60000
ANSWER_RATE_LIMIT_MAX=60
ANSWER_RATE_LIMIT_WINDOW_MS=60000
SANDBOX_RATE_LIMIT_MAX=30
SANDBOX_RATE_LIMIT_WINDOW_MS=60000
PUSH_RATE_LIMIT_MAX=10
PUSH_RATE_LIMIT_WINDOW_MS=60000
# /billing/checkout and API-key rotation.
BILLING_RATE_LIMIT_MAX=10
BILLING_RATE_LIMIT_WINDOW_MS=60000
# Webhook registration/listing/deletion.
WEBHOOKS_RATE_LIMIT_MAX=20
WEBHOOKS_RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# Workers: connection limits, routing eligibility
# =============================================================================

# SSE connection attempts per IP per window (anti-sybil guard #1).
WORKER_RATE_LIMIT_MAX_CONNECTIONS=5
WORKER_RATE_LIMIT_WINDOW_MS=60000
# Reputation gate: once a worker has this many answers, they keep receiving
# questions only while their consensus match ratio stays at or above
# WORKER_MIN_MATCH_RATIO.
WORKER_MIN_ANSWERS_BEFORE_REPUTATION_GATE=5
WORKER_MIN_MATCH_RATIO=0.2
# Once past the reputation gate, a worker must also keep at least this much
# on-chain stake (stroops) to keep receiving questions. 0 disables the check.
WORKER_MIN_STAKE_STROOPS=0

# Fraud scoring (fraudScoring.js) flags anomalous workers for admin review.
# true also excludes flagged workers from dispatch automatically.
FRAUD_AUTO_EXCLUDE=false

# Collusion-detection heuristics (collusion.js). Pair scores run 0..1.
# At FLAG_SCORE a pair is flagged and loses the reconcile fast path when it
# agrees; at SUSPEND_SCORE both workers also sit out routing until an
# operator clears them via POST /admin/collusion/clear.
COLLUSION_MIN_SHARED_QUESTIONS=5
COLLUSION_SYNC_WINDOW_MS=1500
COLLUSION_FLAG_SCORE=0.6
COLLUSION_SUSPEND_SCORE=0.85

# Cross-instance quorum collection over Redis pub/sub (#159/#160). Answers
# that reach an instance which doesn't own the question are forwarded on
# `<prefix><questionId>`. ANSWER_TIMEOUT is how long the owner waits for
# forwarded answers before the normal timeout/refund path takes over.
QUORUM_CHANNEL_PREFIX=quorum:answers:
QUORUM_ANSWER_TIMEOUT_MS=30000

# =============================================================================
# Sessions and operator access
# =============================================================================

# Signs worker session tokens (proves control of an address before it can
# submit an answer as itself — see workerAuth.js). Falls back to a random
# per-process secret if unset, which is fine for local dev but means every
# worker has to re-authenticate on every restart. Set this explicitly for
# anything beyond local dev: openssl rand -hex 32
SESSION_SECRET=
WORKER_SESSION_TTL_MS=43200000

# Graceful SESSION_SECRET rotation (#7): set PREVIOUS to the old secret when
# deploying a new SESSION_SECRET, and tokens signed with it keep verifying
# for GRACE_MS after this process starts. 0 disables the grace window.
SESSION_SECRET_PREVIOUS=
SESSION_SECRET_ROTATION_GRACE_MS=0

# Bearer token gating /admin/*. Unset = the admin console refuses every
# request (fails closed, not open).
ADMIN_TOKEN=
# Additional comma-separated admin tokens. Each authenticates independently,
# so one operator's access can be revoked by removing just their token.
ADMIN_TOKENS=

# =============================================================================
# Observability and security headers
# =============================================================================

# Bearer token for GET /metrics. Blank = open, the usual setup for a scrape
# target on a private network.
METRICS_TOKEN=
# How often the health-probe gauges (store, RPC) and the stuck-job scan run.
METRICS_PROBE_INTERVAL_MS=15000
METRICS_JOB_SCAN_INTERVAL_MS=60000

# Strict-Transport-Security is on unless this is false.
HSTS_ENABLED=true
# Comma-separated extra origins the frontend may fetch()/stream from — only
# needed when the UI is hosted on a different origin than this API.
CSP_CONNECT_SRC=

# ALERT DRILLS ONLY: enables /admin/faults to inject HTTP errors and latency.
# securityPosture.js refuses to start a production deployment with this on.
ARBITER_FAULT_INJECTION=false

# On-call alerting — optional. Leave ALERT_WEBHOOK_URL blank to disable every
# alert. Payloads carry a Slack-compatible `text` field, so a Slack incoming
# webhook works as-is. Set ALERT_TREASURY_MIN_USDC to also alert once when the
# platform or fiat-pool USDC balance drops below it (re-arms on recovery).
ALERT_WEBHOOK_URL=
ALERT_TREASURY_MIN_USDC=
ALERT_TREASURY_INTERVAL_MS=300000

# =============================================================================
# Disaster recovery sweep (disasterRecovery.js)
# =============================================================================

# Refunds on-chain Pending questions that no local state can still settle
# (e.g. after the store was lost). Needs contract v0.3.0+ and PLATFORM_SECRET.
# Only questions older than MIN_AGE_LEDGERS are touched, local in-flight
# records older than STALE_INFLIGHT_MS count as abandoned, and one sweep
# refunds at most MAX_REFUNDS_PER_SWEEP.
RECOVERY_SWEEP_ENABLED=true
RECOVERY_SWEEP_INTERVAL_MS=300000
RECOVERY_MIN_AGE_LEDGERS=12
RECOVERY_STALE_INFLIGHT_MS=1800000
RECOVERY_MAX_REFUNDS_PER_SWEEP=50

# =============================================================================
# Web Push (optional)
# =============================================================================

# Generate a keypair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave blank to disable push entirely (SSE-only dispatch still works fully).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Skip push for any tier with a shorter quorum window than this — a push
# round-trip realistically takes several seconds, so notifying for a very
# short window just wastes a message the worker can't act on in time.
PUSH_MIN_TIMEOUT_MS=20000

# =============================================================================
# Fiat rails (optional)
# =============================================================================

# Home domain of the SEP-24/SEP-12 anchor used for the app's fiat rails
# (bank deposit/withdraw, KYC status — see anchorClient.js). Unset disables
# /anchor/* entirely.
ANCHOR_HOME_DOMAIN=

# Non-crypto onramp (billing.js): API-key customers pay via Stripe and are
# settled on-chain from ONE pooled balance under FIAT_POOL_ADDRESS —
# deliberately a DIFFERENT keypair than PLATFORM_SECRET/PLATFORM_ADDRESS
# above, so customer float never commingles with platform fee revenue. All
# four must be set for /billing/* and the API-key path of POST /oracle to
# work; unset disables that surface entirely (fails closed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FIAT_POOL_SECRET=
FIAT_POOL_ADDRESS=
MIN_TOPUP_USD=10

# =============================================================================
# Settlement webhooks (webhooks.js / webhookDelivery.js, optional)
# =============================================================================

# Key used to encrypt webhook signing secrets at rest (AES-256-GCM). Set it
# for production. Changing it later makes existing secrets unreadable, so
# owners would have to re-register.
#
# WARNING: if this is unset, webhook signing secrets are stored in PLAINTEXT
# (a `raw:` prefix) and a warning is logged at startup and on each registration.
# Never run production without it.
WEBHOOK_SECRET_ENCRYPTION_KEY=
# Delivery attempts per event (including the first) and the first retry
# delay; each later retry doubles it (+ up to 20% jitter).
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_RETRY_BASE_DELAY_MS=5000
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_PER_OWNER=10
# LOCAL DEV ONLY: allow http:// and loopback/private-network webhook targets.
# Never enable in production (it turns registration into an SSRF vector).
WEBHOOK_ALLOW_INSECURE_TARGETS=false

# =============================================================================
# Referrals and auto-withdraw
# =============================================================================

# Referral-based worker onboarding (referrals.js). Codes are tracked by this
# backend only; there is no on-chain referral payout.
REFERRAL_MAX_USES_PER_CODE=25
# true = POST /workers/:address/onboard requires a referral code.
REFERRAL_REQUIRED_FOR_SPONSORED_ONBOARDING=false
REFERRALS_RATE_LIMIT_MAX=10
REFERRALS_RATE_LIMIT_WINDOW_MS=60000

# Payer referrals (#99, payerReferrals.js): a payer who passes a worker's
# referral code (body.referralCode on POST /oracle) on their FIRST verified
# payment is attributed to that worker, once, permanently. The worker earns
# an informational credit of REWARD_BPS basis points of that first payment
# (500 = 5%; 0 = attribution only), listed at GET /admin/referral-earnings.
# Nothing is paid out.
PAYER_REFERRALS_ENABLED=true
PAYER_REFERRAL_REWARD_BPS=500

# Auto-withdraw (autoWithdraw.js): a worker opts in to having their full Owed
# balance prepared as an unsigned withdraw transaction once it crosses their
# threshold. MIN_THRESHOLD is the lowest threshold a worker may set
# (stroops; default 1 USDC), PENDING_TTL is how long a prepared transaction
# stays valid, SWEEP_INTERVAL is the backstop sweep across opted-in workers.
AUTO_WITHDRAW_MIN_THRESHOLD_STROOPS=10000000
AUTO_WITHDRAW_PENDING_TTL_MS=600000
AUTO_WITHDRAW_SWEEP_INTERVAL_MS=3600000
