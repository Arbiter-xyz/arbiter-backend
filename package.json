{
  "name": "arbiter-backend",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Dispatch, settlement, and billing backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "for f in src/*.js scripts/*.js; do node --check \"$f\" || exit 1; done",
    "lint": "npx --yes eslint@10.12.0 .",
    "lint:prune": "npx --yes eslint@10.12.0 . --prune-suppressions",
    "test": "node --test --test-timeout=30000",
    "loadtest": "node scripts/loadtest.js",
    "verify-provenance": "node scripts/verify-provenance.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@opentelemetry/api": "^1.9.1",
    "@stellar/stellar-sdk": "^16.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "stripe": "^22.6.2",
    "web-push": "^3.6.7"
  }
}
